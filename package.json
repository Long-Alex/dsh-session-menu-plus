{
  "name": "dsh-session-menu-plus",
  "version": "1.6.0",
  "description": "DeepSeek Harness plugin: right-click opening and extra Session actions in the sidebar Session menu",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "harness-plugin",
    "session",
    "context-menu",
    "markdown-export"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Long-Alex/dsh-session-menu-plus.git"
  },
  "homepage": "https://github.com/Long-Alex/dsh-session-menu-plus#readme",
  "bugs": {
    "url": "https://github.com/Long-Alex/dsh-session-menu-plus/issues"
  },
  "type": "module",
  "files": [
    "index.js",
    "fs-ops.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./fs-ops": "./fs-ops.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  }
}
